import paho.mqtt.client as mqtt

# Initial State
door_state = "CLOSED"
node_trust_score = 100

def on_connect(client, userdata, flags, rc):
    print("Consensus Engine Online. Monitoring network...")
    client.subscribe("home/door")
    client.subscribe("home/motion")

def on_message(client, userdata, msg):
    global door_state, node_trust_score
    topic = msg.topic
    payload = msg.payload.decode("utf-8")
    
    if node_trust_score <= 0:
        return # Ignore quarantined nodes

    if topic == "home/door":
        door_state = payload
        print(f"[SENSOR] Door is now {door_state}")
        
    elif topic == "home/motion" and payload == "DETECTED":
        print("[SENSOR] Motion Detected in room.")
        
        # The Impossibility Detection Logic
        if door_state == "CLOSED":
            print("\n[WARNING] Impossibility Detected: Motion cannot exist in a closed, locked room!")
            node_trust_score -= 50
            print(f"[SYSTEM] Node Trust Score dropped to: {node_trust_score}/100")
            
            if node_trust_score <= 0:
                print("[ALERT] QUARANTINE TRIGGERED. ESP32 Node Isolated.")
        else:
            print("[SYSTEM] Motion validated by open door. State is logical.")

client = mqtt.Client()
client.on_connect = on_connect
client.on_message = on_message

client.connect("broker.hivemq.com", 1883, 60)
client.loop_forever()